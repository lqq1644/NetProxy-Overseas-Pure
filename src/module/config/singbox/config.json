{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "output": "stderr",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/data/adb/modules/netproxy/config/singbox/cache.db"
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9999",
      "secret": "singbox"
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "singbox",
      "dashboard": {
        "enabled": true,
        "path": "/data/adb/modules/netproxy/webroot/sing-box-dashboard",
        "http_client": "s-download"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "Proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        }
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "dns-direct",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      { "clash_mode": "Proxy", "action": "route", "server": "dns-proxy" },
      { "clash_mode": "Direct", "action": "route", "server": "dns-proxy" },
      { "action": "evaluate", "server": "dns-proxy" },
      {
        "match_response": true,
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "clash_mode": "RuleAllowAds", "invert": true },
          { "match_response": true, "rule_set": ["block", "Ads_AWAvenue"] }
        ],
        "action": "reject"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7080
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      { "type": "local", "tag": ["block", "direct", "proxy"], "format": "source", "path": "./rules/local/{tag}.json" },
      {
        "type": "remote",
        "tag": "Ads_AWAvenue",
        "format": "source",
        "url": "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Singbox.json",
        "update_interval": "24h",
        "path": "./rules/remote/Ads_AWAvenue.json"
      }
    ],
    "rules": [
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },
      { "action": "sniff" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 53 },
          { "protocol": "dns" }
        ],
        "action": "hijack-dns"
      },
      { "protocol": "quic", "action": "reject" },
      { "network": "udp", "port": 443, "action": "reject" },
      { "clash_mode": "Proxy", "action": "route", "outbound": "Proxy" },
      { "rule_set": "proxy", "action": "route", "outbound": "Proxy" },
      { "rule_set": "direct", "action": "route", "outbound": "direct" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "clash_mode": "RuleAllowAds", "invert": true },
          { "rule_set": ["block", "Ads_AWAvenue"] }
        ],
        "action": "reject"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Rule",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "direct"
  }
}
